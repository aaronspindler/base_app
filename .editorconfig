# EditorConfig helps maintain consistent coding styles across different editors
# https://editorconfig.org

root = true

# Universal settings
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python files
[*.py]
indent_size = 4
max_line_length = 88

# YAML files
[*.{yml,yaml}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# JavaScript/TypeScript files
[*.{js,jsx,ts,tsx}]
indent_size = 2

# HTML templates
[*.html]
indent_size = 2

# CSS/SCSS files
[*.{css,scss,sass}]
indent_size = 2

# Shell scripts
[*.{sh,bash}]
indent_size = 2

# Markdown files
[*.{md,markdown}]
trim_trailing_whitespace = false
indent_size = 2

# Makefile
[Makefile]
indent_style = tab

# Django templates
[*.{html,txt}]
indent_size = 2

# Docker files
[{Dockerfile,docker-compose.yml}]
indent_size = 2

# Git config files
[.git*]
indent_size = 2

# Package files
[{package.json,package-lock.json}]
indent_size = 2

# Requirements files
[requirements*.txt]
indent_size = 0

# Config files
[*.{ini,cfg,conf}]
indent_size = 4

# SQL files
[*.sql]
indent_size = 2

# XML files
[*.xml]
indent_size = 2
