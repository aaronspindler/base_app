# Git attributes for consistent handling across platforms

# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Force LF for specific file types (cross-platform consistency)
*.py text eol=lf
*.pyw text eol=lf
*.pyx text eol=lf
*.pxd text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.md text eol=lf
*.rst text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.sql text eol=lf
*.xml text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.env.* text eol=lf
requirements*.txt text eol=lf

# Binary files (should not be modified)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.tgz binary
*.pyc binary
*.pyo binary
*.pyd binary
*.so binary
*.dll binary
*.exe binary
*.db binary
*.sqlite3 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Language statistics (help GitHub detect languages correctly)
*.html linguist-detectable=true
*.css linguist-detectable=true
*.js linguist-detectable=true
*.py linguist-detectable=true
templates/*.html linguist-language=Django

# Exclude from language statistics
static/vendor/* linguist-vendored
static/lib/* linguist-vendored
node_modules/* linguist-vendored
*.min.js linguist-vendored
*.min.css linguist-vendored
jquery*.js linguist-vendored
bootstrap*.js linguist-vendored
bootstrap*.css linguist-vendored

# Documentation
*.md linguist-documentation
*.rst linguist-documentation
docs/* linguist-documentation

# Generated files (exclude from diffs)
staticfiles/* linguist-generated
*.min.js linguist-generated
*.min.css linguist-generated
migrations/* linguist-generated
